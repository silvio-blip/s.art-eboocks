{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/bot",
      "destination": "/api/bot.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/|_next/|favicon\\.ico|robots\\.txt|sitemap\\.xml|.*\\..*).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(.*facebookexternalhit.*|.*whatsapp.*|.*twitterbot.*|.*discordbot.*|.*telegrambot.*|.*facebot.*|.*slurp.*|.*ia_archiver.*|.*bingbot.*|.*linkedinbot.*|.*googlebot.*|.*developers.facebook.com.*)"
        }
      ],
      "destination": "/api/bot"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
