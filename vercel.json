{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "product",
          "value": "(?<product>.*)"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebook|whatsapp|twitterbot|discordbot|telegrambot|facebot|slurp|ia_archiver).*"
        }
      ],
      "destination": "/api/og?product=:product"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
